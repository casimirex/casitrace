// Casitrace database schema. Models are grouped by bounded context (roadmap-v2 §4.1).
// Rules: UUIDv7 ids generated by the application (ADR 0004); UTC timestamptz; explicit org ownership (ADR 0003).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── platform ────────────────────────────────────────────────────────────────

/// Append-only record of every state-changing command (ADR 0007). UPDATE/DELETE are blocked by a trigger.
model AuditLog {
  id           String   @id @db.Uuid
  orgId        String?  @map("org_id") @db.Uuid
  actorType    String   @map("actor_type") // user | system | api_client
  actorId      String?  @map("actor_id") @db.Uuid
  action       String // e.g. "organisation.created"
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  requestId    String?  @map("request_id")
  data         Json?
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([orgId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

/// Transactional outbox (ADR 0010). Written in the same transaction as the state change, relayed by the worker.
model OutboxEvent {
  id            String    @id @db.Uuid
  orgId         String?   @map("org_id") @db.Uuid
  type          String // e.g. "organisation.created"
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([publishedAt, occurredAt])
  @@map("outbox_event")
}
