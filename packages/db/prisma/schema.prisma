// Casitrace database schema. Models are grouped by bounded context (roadmap-v2 §4.1).
// Rules: UUIDv7 ids generated by the application (ADR 0004); UTC timestamptz; explicit org ownership (ADR 0003).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── platform ────────────────────────────────────────────────────────────────

/// Append-only record of every state-changing command (ADR 0007). UPDATE/DELETE are blocked by a trigger.
model AuditLog {
  id           String   @id @db.Uuid
  orgId        String?  @map("org_id") @db.Uuid
  actorType    String   @map("actor_type") // user | system | api_client
  actorId      String?  @map("actor_id") @db.Uuid
  action       String // e.g. "organisation.created"
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  requestId    String?  @map("request_id")
  data         Json?
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([orgId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

/// Transactional outbox (ADR 0010). Written in the same transaction as the state change, relayed by the worker.
model OutboxEvent {
  id            String    @id @db.Uuid
  orgId         String?   @map("org_id") @db.Uuid
  type          String // e.g. "organisation.created"
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([publishedAt, occurredAt])
  @@map("outbox_event")
}

// ─── identity & access (Better Auth tables, ADR 0009) ───────────────────────
// Field names must match Better Auth's schema; table/column names are snake_case.
// IDs are UUIDv7 supplied by Better Auth's generateId hook.

model User {
  id               String   @id @db.Uuid
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")
  /// Platform staff only: "super_admin" | "support". Null for every customer user.
  platformRole     String?  @map("platform_role")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  accounts      Account[]
  memberships   Member[]
  invitations   Invitation[]
  twoFactors    TwoFactor[]
  notifications Notification[]

  @@map("user")
}

model Session {
  id                   String   @id @db.Uuid
  token                String   @unique
  userId               String   @map("user_id") @db.Uuid
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

/// The tenant (ADR 0003).
model Organization {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  members     Member[]
  invitations Invitation[]
  profile     OrganizationProfile?

  @@map("organization")
}

model Member {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// Role template name: owner | admin | operator | reviewer | viewer (roadmap-v2 §4.3).
  role           String   @default("viewer")
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  inviterId      String   @map("inviter_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model TwoFactor {
  id                      String    @id @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model RateLimit {
  id          String @id @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}

/// Per-account sign-in failure counter for lockout (roadmap-v2 P2). Keyed by a hash of the normalised email.
model LoginThrottle {
  emailHash   String    @id @map("email_hash")
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("login_throttle")
}

// ─── parties (P3) ───────────────────────────────────────────────────────────
// Every table below is tenant-owned: org_id + RLS (ADR 0008).

/// Business identity of an organisation. Verification is set by platform staff (review queue).
model OrganizationProfile {
  orgId                   String    @id @map("org_id") @db.Uuid
  legalName               String    @map("legal_name")
  registrationNumber      String?   @map("registration_number")
  vatNumber               String?   @map("vat_number")
  countryCode             String    @map("country_code") @db.Char(2)
  addressLine1            String?   @map("address_line1")
  addressLine2            String?   @map("address_line2")
  city                    String?
  postalCode              String?   @map("postal_code")
  region                  String?
  /// grower | mill | bottler | blender | distributor | retailer | other
  businessRoles           String[]  @map("business_roles")
  website                 String?
  description             String?
  /// Listed in the public directory (opt-in, P7).
  publicListing           Boolean   @default(false) @map("public_listing")
  /// unverified | pending | verified
  verificationStatus      String    @default("unverified") @map("verification_status")
  verificationNote        String?   @map("verification_note")
  verificationRequestedAt DateTime? @map("verification_requested_at") @db.Timestamptz(3)
  verifiedAt              DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@map("organization_profile")
}

/// Farm, grove plot, mill, tank, warehouse, bottling plant or store.
model Location {
  id           String    @id @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  /// Short code unique within the organisation, e.g. "GROVE-N-03".
  code         String
  name         String
  /// farm | plot | facility | storage | warehouse | store | other
  type         String
  parentId     String?   @map("parent_id") @db.Uuid
  gln          String?
  countryCode  String?   @map("country_code") @db.Char(2)
  addressLine1 String?   @map("address_line1")
  city         String?
  postalCode   String?   @map("postal_code")
  region       String?
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  /// GeoJSON Polygon or MultiPolygon (RFC 7946, WGS 84), validated on input.
  boundary     Json?
  areaHa       Decimal?  @map("area_ha") @db.Decimal(14, 4)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Location?  @relation("LocationParent", fields: [parentId], references: [id], onDelete: Restrict)
  children Location[] @relation("LocationParent")

  @@unique([orgId, code])
  @@index([orgId, type])
  @@map("location")
}

/// A supplier or customer. Either linked to an on-platform organisation or external (off-platform).
model TradingPartner {
  id                 String    @id @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  name               String
  /// supplier | customer | both
  kind               String
  linkedOrgId        String?   @map("linked_org_id") @db.Uuid
  email              String?
  countryCode        String?   @map("country_code") @db.Char(2)
  registrationNumber String?   @map("registration_number")
  gln                String?
  addressLine1       String?   @map("address_line1")
  city               String?
  postalCode         String?   @map("postal_code")
  notes              String?
  /// pending | approved | suspended (supplier approval, P6)
  approvalStatus     String    @default("pending") @map("approval_status")
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedById       String?   @map("approved_by_id") @db.Uuid
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([orgId, linkedOrgId])
  @@index([orgId, name])
  @@map("trading_partner")
}

// ─── catalog (P3) ───────────────────────────────────────────────────────────

/// Global units of measure (ADR 0006). Read-only for the app role.
model Uom {
  code            String           @id
  name            String
  /// mass | volume | count
  dimension       String
  /// Factor to the dimension's base unit (kg, l, unit).
  toBase          Decimal          @map("to_base") @db.Decimal(24, 12)
  productVersions ProductVersion[]

  @@map("uom")
}

/// Stable product identity. Edits create a new ProductVersion; lots reference versions (P5).
model Product {
  id             String    @id @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  sku            String
  /// GTIN of the current version, mirrored for uniqueness within the organisation.
  gtin           String?
  currentVersion Int       @map("current_version")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions ProductVersion[]

  @@unique([orgId, sku])
  @@unique([orgId, gtin])
  @@map("product")
}

/// Immutable snapshot of a product's definition (append-only, ADR 0007).
model ProductVersion {
  id                String   @id @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  version           Int
  name              String
  /// olives | olive_oil_bulk | olive_oil_packaged | olive_pomace | other
  category          String
  uomCode           String   @map("uom_code")
  description       String?
  gtin              String?
  originCountry     String?  @map("origin_country") @db.Char(2)
  originRegion      String?  @map("origin_region")
  /// EU Annex II allergen codes, e.g. "nuts"
  allergens         String[]
  storageConditions String?  @map("storage_conditions")
  shelfLifeDays     Int?     @map("shelf_life_days")
  /// Category-specific attributes validated by a versioned schema in @casitrace/contracts.
  attributes        Json
  attributesSchema  String   @map("attributes_schema")
  changeNote        String?  @map("change_note")
  createdById       String?  @map("created_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product     Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  uom         Uom                     @relation(fields: [uomCode], references: [code])
  components  ProductComponent[]
  conversions ProductUnitConversion[]

  @@unique([productId, version])
  @@index([orgId, category])
  @@map("product_version")
}

/// Composition of a product version: another product (e.g. bulk oil in a bottle) or a named ingredient.
model ProductComponent {
  id                 String   @id @db.Uuid
  orgId              String   @map("org_id") @db.Uuid
  productVersionId   String   @map("product_version_id") @db.Uuid
  ordinal            Int
  componentProductId String?  @map("component_product_id") @db.Uuid
  name               String
  percentage         Decimal? @db.Decimal(7, 4)

  productVersion ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Restrict)

  @@unique([productVersionId, ordinal])
  @@map("product_component")
}

/// Product-specific conversion between units, e.g. 1 unit (bottle) = 0.75 l, 1 l = 0.916 kg.
model ProductUnitConversion {
  id               String  @id @db.Uuid
  orgId            String  @map("org_id") @db.Uuid
  productVersionId String  @map("product_version_id") @db.Uuid
  fromUom          String  @map("from_uom")
  toUom            String  @map("to_uom")
  factor           Decimal @db.Decimal(24, 12)

  productVersion ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Restrict)

  @@unique([productVersionId, fromUom, toUom])
  @@map("product_unit_conversion")
}

// ─── evidence (P4) ──────────────────────────────────────────────────────────
// A hash proves a file is unchanged since upload, not that it is true (roadmap-v2 §4.4).

/// A piece of evidence: a document or photo, optionally a certificate with structured fields.
model Evidence {
  id                 String    @id @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  /// certificate | lab_report | inspection_report | supplier_declaration | delivery_note | photo | other
  type               String
  title              String
  description        String?
  /// submitted | checked | verified | rejected | expired | revoked
  status             String    @default("submitted")
  currentFileVersion Int       @map("current_file_version")
  // Certificate fields (type = certificate)
  scheme             String?
  issuerName         String?   @map("issuer_name")
  issuerPartnerId    String?   @map("issuer_partner_id") @db.Uuid
  certificateNumber  String?   @map("certificate_number")
  scope              String?
  validFrom          DateTime? @map("valid_from") @db.Date
  validUntil         DateTime? @map("valid_until") @db.Date
  /// Smallest expiry warning already sent (30, 7 or 0 days), so the job never repeats one.
  expiryNoticeDays   Int?      @map("expiry_notice_days")
  createdById        String?   @map("created_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  files   EvidenceFile[]
  links   EvidenceLink[]
  changes EvidenceStatusChange[]

  @@index([orgId, status])
  @@index([orgId, type])
  @@index([validUntil])
  @@map("evidence")
}

/// One uploaded file version. Immutable except for the scan result columns (trigger-enforced).
model EvidenceFile {
  id           String    @id @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  evidenceId   String    @map("evidence_id") @db.Uuid
  version      Int
  storageKey   String    @unique @map("storage_key")
  sha256       String    @db.Char(64)
  sizeBytes    Int       @map("size_bytes")
  /// Sniffed from the file content, not taken from the client.
  mediaType    String    @map("media_type")
  originalName String    @map("original_name")
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  /// pending | clean | infected | error
  scanStatus   String    @default("pending") @map("scan_status")
  scanDetail   String?   @map("scan_detail")
  scannedAt    DateTime? @map("scanned_at") @db.Timestamptz(3)

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([evidenceId, version])
  @@index([sha256])
  @@map("evidence_file")
}

/// What a piece of evidence supports. target_type: organisation | location | partner | product | product_version | lot | event
model EvidenceLink {
  id          String   @id @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  evidenceId  String   @map("evidence_id") @db.Uuid
  targetType  String   @map("target_type")
  targetId    String   @map("target_id") @db.Uuid
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([evidenceId, targetType, targetId])
  @@index([orgId, targetType, targetId])
  @@map("evidence_link")
}

/// Every status transition with who, when and why (append-only).
model EvidenceStatusChange {
  id          String   @id @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  evidenceId  String   @map("evidence_id") @db.Uuid
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  reason      String?
  actorType   String   @map("actor_type")
  actorId     String?  @map("actor_id") @db.Uuid
  fileVersion Int?     @map("file_version")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([evidenceId, occurredAt])
  @@map("evidence_status_change")
}

// ─── notifications (P4) ─────────────────────────────────────────────────────

/// In-app notification for one user. Owned by the user (filtered by user_id), not under tenant RLS.
model Notification {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  orgId     String?   @map("org_id") @db.Uuid
  kind      String
  title     String
  body      String
  link      String?
  /// Dedupe key, e.g. "evidence-expiry:<id>:7"; one notification per user per key.
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notification")
}

// ─── traceability (P5) ──────────────────────────────────────────────────────
// Events are the source of truth (append-only, ADR 0007). Lot quantity/status are a projection
// recomputed from non-voided event lines. Genealogy edges are written with the event.

/// A quantity of one product version (a batch). Quantity and status are maintained from events.
model Lot {
  id               String   @id @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productVersionId String   @map("product_version_id") @db.Uuid
  lotCode          String   @map("lot_code")
  uomCode          String   @map("uom_code")
  /// Current balance in uom_code (projection of event lines).
  quantity         Decimal  @default(0) @db.Decimal(18, 6)
  /// Quantity first created (outputs of the creating event).
  initialQuantity  Decimal  @map("initial_quantity") @db.Decimal(18, 6)
  /// active | consumed | shipped | on_hold | recalled | voided
  status           String   @default("active")
  holdReason       String?  @map("hold_reason")
  /// Set while the lot is part of a real (not drill) recall; blocks use and shows the public banner.
  recallCaseId     String?  @map("recall_case_id") @db.Uuid
  locationId       String?  @map("location_id") @db.Uuid
  createdByEventId String   @map("created_by_event_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Lot codes are unique among non-voided lots (partial unique index in SQL), so a corrected
  /// event can reuse the code of the lot it replaces.
  @@index([orgId, productId, lotCode])
  @@index([orgId, status])
  @@index([orgId, lotCode])
  @@map("lot")
}

/// Something that happened to lots. Never updated or deleted; corrected by a VOID event.
model TraceEvent {
  id             String   @id @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  /// ORIGINATE | RECEIVE | TRANSFORM | SHIP | ADJUST | VOID
  type           String
  /// harvest | milling | blending | bottling | split | other (TRANSFORM/ORIGINATE detail)
  process        String?
  /// Business time: when it happened.
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  /// System time: when it was recorded.
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  locationId     String?  @map("location_id") @db.Uuid
  partnerId      String?  @map("partner_id") @db.Uuid
  kdes           Json
  kdeSchema      String   @map("kde_schema")
  note           String?
  /// For VOID: the event it voids.
  voidsEventId   String?  @unique @map("voids_event_id") @db.Uuid
  /// Set when mass balance failed and someone with event:override accepted it.
  overrideReason String?  @map("override_reason")
  /// Inputs/outputs in kg at the time of recording (for audit of the mass-balance decision).
  massBalance    Json?    @map("mass_balance")
  idempotencyKey String?  @map("idempotency_key")
  requestHash    String?  @map("request_hash")
  actorId        String?  @map("actor_id") @db.Uuid

  lines TraceEventLine[]

  @@unique([orgId, idempotencyKey])
  @@index([orgId, occurredAt])
  @@index([orgId, type])
  @@map("trace_event")
}

/// One lot's part in an event. role: input (consumed/shipped) | output (created) | adjust (signed delta).
model TraceEventLine {
  id       String  @id @db.Uuid
  orgId    String  @map("org_id") @db.Uuid
  eventId  String  @map("event_id") @db.Uuid
  lotId    String  @map("lot_id") @db.Uuid
  role     String
  quantity Decimal @db.Decimal(18, 6)
  uomCode  String  @map("uom_code")

  event TraceEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([lotId])
  @@index([eventId])
  @@map("trace_event_line")
}

/// Genealogy: parent lot → child lot through an event (materialised for fast traces).
model LotEdge {
  id          String @id @db.Uuid
  orgId       String @map("org_id") @db.Uuid
  parentLotId String @map("parent_lot_id") @db.Uuid
  childLotId  String @map("child_lot_id") @db.Uuid
  eventId     String @map("event_id") @db.Uuid

  @@unique([parentLotId, childLotId, eventId])
  @@index([parentLotId])
  @@index([childLotId])
  @@map("lot_edge")
}

// ─── exchange (P6) ──────────────────────────────────────────────────────────
// Rows here involve two organisations. RLS lets each party see the row; nothing else of the other
// party's data becomes visible except through a SharingGrant checked by the application.

/// A shipment from one Casitrace organisation to another, waiting for the receiver to book it in.
model Handoff {
  id             String    @id @db.Uuid
  senderOrgId    String    @map("sender_org_id") @db.Uuid
  receiverOrgId  String    @map("receiver_org_id") @db.Uuid
  shipEventId    String    @unique @map("ship_event_id") @db.Uuid
  /// pending | accepted | disputed | cancelled
  status         String    @default("pending")
  /// What the receiver may see of the shipment: lot codes, products, GTINs, quantities.
  lines          Json
  shippedAt      DateTime  @map("shipped_at") @db.Timestamptz(3)
  disputeReason  String?   @map("dispute_reason")
  receiveEventId String?   @map("receive_event_id") @db.Uuid
  decidedById    String?   @map("decided_by_id") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([receiverOrgId, status])
  @@index([senderOrgId, status])
  @@map("handoff")
}

/// Genealogy across organisations: the sender's lot became the receiver's lot (append-only).
model CrossLotLink {
  id              String   @id @db.Uuid
  upstreamOrgId   String   @map("upstream_org_id") @db.Uuid
  upstreamLotId   String   @map("upstream_lot_id") @db.Uuid
  downstreamOrgId String   @map("downstream_org_id") @db.Uuid
  downstreamLotId String   @map("downstream_lot_id") @db.Uuid
  handoffId       String   @map("handoff_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([upstreamLotId, downstreamLotId])
  @@index([downstreamLotId])
  @@index([upstreamLotId])
  @@map("cross_lot_link")
}

/// Explicit permission for another organisation to see a scoped part of the grantor's data.
model SharingGrant {
  id              String    @id @db.Uuid
  grantorOrgId    String    @map("grantor_org_id") @db.Uuid
  /// Null = every organisation downstream of the lot (reached through handoffs).
  granteeOrgId    String?   @map("grantee_org_id") @db.Uuid
  /// lot | evidence
  kind            String
  lotId           String?   @map("lot_id") @db.Uuid
  evidenceId      String?   @map("evidence_id") @db.Uuid
  /// How many steps of the grantor's genealogy upstream / downstream of the lot are visible.
  upstreamDepth   Int       @default(0) @map("upstream_depth")
  downstreamDepth Int       @default(0) @map("downstream_depth")
  includeKdes     Boolean   @default(false) @map("include_kdes")
  includeEvidence Boolean   @default(false) @map("include_evidence")
  note            String?
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById     String?   @map("revoked_by_id") @db.Uuid

  @@index([grantorOrgId, kind])
  @@index([granteeOrgId, kind])
  @@index([lotId])
  @@index([evidenceId])
  @@map("sharing_grant")
}

/// Every use of a grant (append-only), visible to grantor and grantee.
model SharedAccess {
  id           String   @id @db.Uuid
  grantId      String   @map("grant_id") @db.Uuid
  grantorOrgId String   @map("grantor_org_id") @db.Uuid
  granteeOrgId String   @map("grantee_org_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  /// trace | trace_report | evidence | evidence_download
  action       String
  resourceId   String?  @map("resource_id") @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([grantId, occurredAt])
  @@index([grantorOrgId, occurredAt])
  @@map("shared_access")
}

/// A buyer asks a supplier on Casitrace for a document.
model EvidenceRequest {
  id                  String    @id @db.Uuid
  requesterOrgId      String    @map("requester_org_id") @db.Uuid
  supplierOrgId       String    @map("supplier_org_id") @db.Uuid
  requesterPartnerId  String    @map("requester_partner_id") @db.Uuid
  evidenceType        String    @map("evidence_type")
  scheme              String?
  note                String?
  dueDate             DateTime? @map("due_date") @db.Date
  /// open | fulfilled | declined | cancelled
  status              String    @default("open")
  fulfilledEvidenceId String?   @map("fulfilled_evidence_id") @db.Uuid
  grantId             String?   @map("grant_id") @db.Uuid
  declineReason       String?   @map("decline_reason")
  createdById         String?   @map("created_by_id") @db.Uuid
  decidedById         String?   @map("decided_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt           DateTime? @map("decided_at") @db.Timestamptz(3)

  @@index([requesterOrgId, status])
  @@index([supplierOrgId, status])
  @@map("evidence_request")
}

/// Documents every supplier must have (verified) before approval.
model SupplierRequirement {
  id           String   @id @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  evidenceType String   @map("evidence_type")
  scheme       String?
  label        String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orgId])
  @@map("supplier_requirement")
}

/// Invitation for an off-platform partner to claim its record by joining Casitrace.
model PartnerClaim {
  id           String    @id @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  partnerId    String    @map("partner_id") @db.Uuid
  email        String
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  claimedOrgId String?   @map("claimed_org_id") @db.Uuid
  claimedById  String?   @map("claimed_by_id") @db.Uuid
  claimedAt    DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orgId, partnerId])
  @@map("partner_claim")
}

// ─── publication (P7) ───────────────────────────────────────────────────────

/// A public product or lot page. The public sees only published, signed versions.
model Passport {
  id             String   @id @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  /// Short public identifier used in URLs and QR codes.
  publicId       String   @unique @map("public_id")
  /// product | lot
  scope          String
  productId      String   @map("product_id") @db.Uuid
  lotId          String?  @map("lot_id") @db.Uuid
  template       String
  /// Which optional sections may be public (field-level disclosure policy).
  disclosure     Json
  /// draft | published | withdrawn
  status         String   @default("draft")
  currentVersion Int      @default(0) @map("current_version")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions PassportVersion[]

  @@index([orgId, status])
  @@index([lotId])
  @@index([productId])
  @@map("passport")
}

/// An immutable published snapshot: exactly what the public sees, signed by the platform key.
model PassportVersion {
  id            String   @id @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  passportId    String   @map("passport_id") @db.Uuid
  version       Int
  /// Canonical JSON of the public content (the signed bytes).
  canonical     String
  /// SHA-256 of the canonical bytes (hex).
  digest        String   @db.Char(64)
  /// Ed25519 signature of the canonical bytes (base64url).
  signature     String
  keyId         String   @map("key_id")
  /// GS1 GTIN-14 and lot code for Digital Link resolution (null when not applicable).
  gtin          String?
  lotCode       String?  @map("lot_code")
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedById String?  @map("published_by_id") @db.Uuid

  passport Passport @relation(fields: [passportId], references: [id], onDelete: Restrict)

  @@unique([passportId, version])
  @@index([gtin, lotCode])
  @@map("passport_version")
}

// ─── recalls (P8) ───────────────────────────────────────────────────────────

/// A recall (or a timed mock-recall drill) started from one or more lots.
model RecallCase {
  id           String    @id @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  code         String
  /// real | drill
  mode         String
  /// open | closed
  status       String    @default("open")
  reason       String
  /// health_risk | quality | regulatory | other
  severity     String
  /// Instructions shown to customers and on public pages.
  instructions String?
  impact       Json?
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  startedById  String?   @map("started_by_id") @db.Uuid
  impactAt     DateTime? @map("impact_at") @db.Timestamptz(3)
  /// First export of the impact set (the drill clock stops here).
  exportedAt   DateTime? @map("exported_at") @db.Timestamptz(3)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(3)
  closedById   String?   @map("closed_by_id") @db.Uuid
  closeNote    String?   @map("close_note")

  lots    RecallLot[]
  notices RecallNotice[]

  @@unique([orgId, code])
  @@index([orgId, status])
  @@map("recall_case")
}

/// A lot in a recall: a starting lot or one found downstream in this organisation.
model RecallLot {
  id     String @id @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  caseId String @map("case_id") @db.Uuid
  lotId  String @map("lot_id") @db.Uuid
  /// root | downstream
  role   String
  depth  Int

  recallCase RecallCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, lotId])
  @@map("recall_lot")
}

/// A customer that received affected product: notified on Casitrace, or listed for contact.
model RecallNotice {
  id               String    @id @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  caseId           String    @map("case_id") @db.Uuid
  partnerId        String    @map("partner_id") @db.Uuid
  /// Set when the customer is on Casitrace: the notice is visible to it.
  recipientOrgId   String?   @map("recipient_org_id") @db.Uuid
  /// platform | external
  channel          String
  /// Shipped lots and quantities (the recalling organisation's records).
  shipments        Json
  notifiedAt       DateTime? @map("notified_at") @db.Timestamptz(3)
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid
  ackNote          String?   @map("ack_note")

  recallCase RecallCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, partnerId])
  @@index([recipientOrgId])
  @@map("recall_notice")
}
