{
  "name": "@casitrace/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist",
    "openapi": "bun scripts/emit-openapi.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@casitrace/contracts": "workspace:*",
    "@casitrace/db": "workspace:*",
    "@casitrace/observability": "workspace:*",
    "@casitrace/shared": "workspace:*",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.14",
    "decimal.js": "10.6.0",
    "hono": "4.13.14",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "otpauth": "9.5.2",
    "pino-pretty": "13.2.0"
  }
}
