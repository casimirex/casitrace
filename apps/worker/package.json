{
  "name": "@casitrace/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@casitrace/db": "workspace:*",
    "@casitrace/shared": "workspace:*",
    "nodemailer": "10.2.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "zod": "4.6.7",
    "@casitrace/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2"
  }
}
