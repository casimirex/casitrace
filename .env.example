# Copy to .env. Values match docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://casitrace:casitrace@localhost:5432/casitrace
TEST_DATABASE_URL=postgresql://casitrace:casitrace@localhost:5432/casitrace_test

API_PORT=3000
WEB_ORIGIN=http://localhost:5173

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=casitrace-evidence
S3_ACCESS_KEY_ID=casitrace
S3_SECRET_ACCESS_KEY=casitrace-dev-secret

SMTP_HOST=localhost
SMTP_PORT=1025
