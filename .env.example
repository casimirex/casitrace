# Copy to .env. Values match docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=debug

# Runtime connections use the non-owner casitrace_app role (ADR 0008); migrations use the owner.
DATABASE_URL=postgresql://casitrace_app:casitrace_app@localhost:5432/casitrace
MIGRATE_DATABASE_URL=postgresql://casitrace:casitrace@localhost:5432/casitrace
TEST_DATABASE_URL=postgresql://casitrace_app:casitrace_app@localhost:5432/casitrace_test
TEST_MIGRATE_DATABASE_URL=postgresql://casitrace:casitrace@localhost:5432/casitrace_test

API_PORT=3000
# Public origin of the web app. The API is served under {WEB_ORIGIN}/api (dev: Vite proxy).
WEB_ORIGIN=http://localhost:5173
# 32+ random bytes in production: openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=casitrace-evidence
S3_ACCESS_KEY_ID=casitrace
S3_SECRET_ACCESS_KEY=casitrace-dev-secret

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Casitrace <no-reply@casitrace.local>"
