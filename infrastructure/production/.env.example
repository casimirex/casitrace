# Production / staging settings for compose.yml. Copy to .env next to this file, fill in, keep it out
# of git (store the real values in the secrets manager). Generate secrets with: openssl rand -hex 32
IMAGE_TAG=latest
SITE_ADDRESS=app.example.eu        # Caddy obtains a TLS certificate for this name
PUBLIC_PORT=443
WEB_ORIGIN=https://app.example.eu
PUBLIC_ORIGIN=https://app.example.eu

AUTH_SECRET=
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=
METRICS_TOKEN=

# Evidence object storage (EU region, private bucket, versioning on).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=casitrace-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Database backups: a DIFFERENT provider or region from the VM (off-site), bucket with object lock.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=s3://casitrace-backups/pg
BACKUP_EVIDENCE_BUCKET=casitrace-evidence-backup
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# 32 bytes hex; losing it makes every backup unreadable. Keep two offline copies.
BACKUP_ENCRYPTION_KEY=

# KMS (from kms/bootstrap.sh)
KMS_ROLE_ID=
KMS_SECRET_ID=
PASSPORT_PREVIOUS_KEYS=[]

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Casitrace <no-reply@example.eu>"

# Alert routing (Alertmanager)
ALERT_FROM=alerts@example.eu
ALERT_SMTP_REQUIRE_TLS=true
ALERT_ONCALL_EMAIL=
ALERT_TICKETS_EMAIL=
